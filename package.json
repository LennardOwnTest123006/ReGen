{
  "name": "regen",
  "productName": "ReGen",
  "version": "1.0.0",
  "description": "ReGen - a single-player 2D action-adventure: explore living worlds, raid dungeons, play mini-games and collect skins.",
  "author": {
    "name": "ReGen Studio",
    "email": "lennardpahl30@gmail.com"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "logo": "node tools/render-logo.mjs",
    "test": "node tools/smoke-test.mjs",
    "dist:win": "node tools/build-windows.mjs",
    "apk": "node tools/build-apk.mjs",
    "build": "node tools/build-all.mjs",
    "pack:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.regenstudio.regen",
    "productName": "ReGen",
    "copyright": "Copyright (c) 2026 ReGen Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "game/**/*",
      "build/icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "compression": "maximum",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "ReGen"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LennardOwnTest123006/ReGen.git"
  },
  "homepage": "https://github.com/LennardOwnTest123006/ReGen"
}